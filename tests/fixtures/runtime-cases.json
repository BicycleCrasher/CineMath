{
  "description": "Golden cases for lib/runtime.js. parseRuntime maps an item.runtime value to minutes (null = unparseable). fitsBudget cases assert the keep/drop decision per budget bucket.",
  "parseRuntime": [
    { "runtime": "126 min", "expected": 126 },
    { "runtime": "47 min", "expected": 47 },
    { "runtime": "47 minutes", "expected": 47 },
    { "runtime": "47m", "expected": 47 },
    { "runtime": "47", "expected": 47 },
    { "runtime": "1h 47m", "expected": 107 },
    { "runtime": "1h47m", "expected": 107 },
    { "runtime": "1 hr 47 min", "expected": 107 },
    { "runtime": "2 hours 6 minutes", "expected": 120,
      "note": "documented quirk: 'hour' alternation matches before 'hours', the dangling 's' blocks the minutes group, so minutes are LOST for the plural-hours long form" },
    { "runtime": "2h", "expected": 120 },
    { "runtime": "3 seasons", "expected": 3,
      "note": "documented quirk: bare leading integer parses even with a non-time unit" },
    { "runtime": 95, "expected": 95 },
    { "runtime": 0, "expected": null },
    { "runtime": -10, "expected": null },
    { "runtime": null, "expected": null },
    { "runtime": "5 series + 14 episodes", "expected": 5,
      "note": "documented quirk: despite the code comment, this parses as 5 minutes (leading integer), it is NOT null" },
    { "runtime": "unknown", "expected": null },
    { "runtime": "TV-MA", "expected": null },
    { "runtime": "", "expected": null },
    { "runtime": "  90 MIN  ", "expected": 90 }
  ],
  "fitsBudget": [
    { "runtime": "126 min", "budget": "standard", "expected": false },
    { "runtime": "126 min", "budget": "long", "expected": true },
    { "runtime": "90 min", "budget": "short", "expected": true },
    { "runtime": "91 min", "budget": "short", "expected": false },
    { "runtime": "30 min", "budget": "quick", "expected": true },
    { "runtime": "31 min", "budget": "quick", "expected": false },
    { "runtime": "300 min", "budget": "any", "expected": true },
    { "runtime": "300 min", "budget": null, "expected": true },
    { "runtime": "5 series + 14 episodes", "budget": "quick", "expected": true,
      "note": "kept because it parses as 5 min (leading-integer quirk), not because it is unparseable" },
    { "runtime": null, "budget": "quick", "expected": true },
    { "runtime": "180 min", "budget": "long", "expected": true },
    { "runtime": "181 min", "budget": "long", "expected": false },
    { "runtime": "120 min", "budget": "standard", "expected": true }
  ]
}
