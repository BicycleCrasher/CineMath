  "pick": [
    { "why": "tmdb guid wins over title", "want": { "tmdbId": 31445, "title": "Heat", "year": 1995 }, "expect": "5d776999" },
    { "why": "exact title+year", "want": { "title": "Heat", "year": 1995, "type": "movie" }, "expect": "5d776831" },
    { "why": "year off by one", "want": { "title": "Heat", "year": 1996, "type": "movie" }, "expect": "5d776831" },
    { "why": "type must agree", "want": { "title": "Heat", "year": 1995, "type": "show" }, "expect": null },
    { "why": "tv type normalizes to show", "want": { "title": "The Bear", "year": 2022, "type": "tv" }, "expect": "5d9c08" },
    { "why": "no type given matches anything", "want": { "title": "The Bear", "year": 2022 }, "expect": "5d9c08" },
    { "why": "unknown tmdb id falls back to title", "want": { "tmdbId": 999999, "title": "Heat", "year": 1995 }, "expect": "5d776831" },
    { "why": "no match at all", "want": { "title": "Nope", "year": 2022 }, "expect": null },
    { "why": "no title and no id", "want": {}, "expect": null }
  ],
  "sync": [
    {
      "why": "queued locally, absent from Plex, never mirrored -> push",
      "in": {
        "localQueued": [{ "ref": "scifi|arrival", "tmdbId": 329865, "title": "Arrival", "year": 2016, "type": "movie", "status": "queued" }],
        "remote": [],
        "mirror": {}
      },
      "expect": {
        "push": ["scifi|arrival"],
        "queueLocally": [],
        "unqueueLocally": [],
        "orphanKeys": [],
        "mirrorNext": {}
      }
    },
    {
      "why": "on Plex, matched to an untracked catalog item -> queue locally and adopt the mirror",
      "in": {
        "localQueued": [],
        "remote": [{ "ratingKey": "r1", "title": "Dune", "year": 2021, "type": "movie", "guids": { "tmdb": 438631 }, "matchedRef": "scifi|dune", "matchedStatus": "none" }],
        "mirror": {}
      },
      "expect": {
        "push": [],
        "queueLocally": [{ "ref": "scifi|dune", "ratingKey": "r1" }],
        "unqueueLocally": [],
        "orphanKeys": [],
        "mirrorNext": { "scifi|dune": { "ratingKey": "r1", "syncedAt": 1700000000000, "origin": "plex" } }
      }
    },
    {
      "why": "we pushed it, Plex no longer has it -> un-queue locally",
      "in": {
        "localQueued": [{ "ref": "crime|heat", "tmdbId": 949, "title": "Heat", "year": 1995, "type": "movie", "status": "queued" }],
        "remote": [],
        "mirror": { "crime|heat": { "ratingKey": "r2", "syncedAt": 1699000000000, "origin": "app" } }
      },
      "expect": {
        "push": [],
        "queueLocally": [],
        "unqueueLocally": ["crime|heat"],
        "orphanKeys": [],
        "mirrorNext": {}
      }
    },
    {
      "why": "unmatched remote items become orphans; already-watched matches are left alone and un-mirrored",
      "in": {
        "localQueued": [],
        "remote": [
          { "ratingKey": "r3", "title": "Some Plex Original", "year": 2024, "type": "movie", "guids": { "tmdb": null }, "matchedRef": null },
          { "ratingKey": "r4", "title": "Moon", "year": 2009, "type": "movie", "guids": { "tmdb": 17431 }, "matchedRef": "scifi|moon", "matchedStatus": "watched" },
          { "ratingKey": "r5", "title": "Alien", "year": 1979, "type": "movie", "guids": { "tmdb": 348 }, "matchedRef": "scifi|alien", "matchedStatus": "skip" }
        ],
        "mirror": { "scifi|moon": { "ratingKey": "r4", "syncedAt": 1699000000000, "origin": "app" } }
      },
      "expect": {
        "push": [],
        "queueLocally": [],
        "unqueueLocally": [],
        "orphanKeys": ["r3"],
        "mirrorNext": {}
      }
    },
    {
      "why": "steady state: queued on both sides, mirror origin preserved, nothing to do",
      "in": {
        "localQueued": [{ "ref": "scifi|dune", "tmdbId": 438631, "title": "Dune", "year": 2021, "type": "movie", "status": "queued" }],
        "remote": [{ "ratingKey": "r1", "title": "Dune", "year": 2021, "type": "movie", "guids": { "tmdb": 438631 }, "matchedRef": "scifi|dune", "matchedStatus": "queued" }],
        "mirror": { "scifi|dune": { "ratingKey": "r1", "syncedAt": 1699000000000, "origin": "app" } }
      },
      "expect": {
        "push": [],
        "queueLocally": [],
        "unqueueLocally": [],
        "orphanKeys": [],
        "mirrorNext": { "scifi|dune": { "ratingKey": "r1", "syncedAt": 1700000000000, "origin": "app" } }
