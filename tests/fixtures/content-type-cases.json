{
  "description": "Golden cases for lib/content-type.js resolveContentType(item, sourceTab, activeTab).",
  "cases": [
    { "name": "explicit item contentType override wins over everything",
      "item": { "contentType": "film-musical", "categories": ["sitcom"] },
      "sourceTab": "scifi", "activeTab": "crime", "expected": "film-musical" },
    { "name": "first mapped category wins",
      "item": { "categories": ["panel", "sitcom"] },
      "sourceTab": "british-comedy", "activeTab": "british-comedy", "expected": "tv-panel" },
    { "name": "unmapped category (specials) falls through to the next category",
      "item": { "categories": ["specials", "sitcom"] },
      "sourceTab": "british-comedy", "activeTab": "british-comedy", "expected": "tv-sitcom" },
    { "name": "all categories unmapped falls back to tab default",
      "item": { "categories": ["specials"] },
      "sourceTab": "british-comedy", "activeTab": "watchlist", "expected": "tv-sitcom" },
    { "name": "news-comedy maps to tv-panel",
      "item": { "categories": ["news-comedy"] },
      "sourceTab": "british-comedy", "activeTab": "british-comedy", "expected": "tv-panel" },
    { "name": "sourceTab default preferred over activeTab",
      "item": {},
      "sourceTab": "scifi-tv", "activeTab": "crime", "expected": "tv-scifi" },
    { "name": "no sourceTab: item _watchlist_source_tab wins over activeTab",
      "item": { "_watchlist_source_tab": "horror" },
      "sourceTab": null, "activeTab": "crime", "expected": "film-horror" },
    { "name": "no sourceTab: item _auteur_source_tab wins over activeTab",
      "item": { "_auteur_source_tab": "musicals" },
      "sourceTab": null, "activeTab": "crime", "expected": "film-musical" },
    { "name": "falls back to activeTab default",
      "item": {},
      "sourceTab": null, "activeTab": "espionage", "expected": "film-espionage" },
    { "name": "unknown tab falls back to film-narrative",
      "item": {},
      "sourceTab": "watchlist", "activeTab": "watchlist", "expected": "film-narrative" },
    { "name": "null item with known activeTab",
      "item": null,
      "sourceTab": null, "activeTab": "heroes-comics-tv", "expected": "tv-heroes" },
    { "name": "null item, unknown activeTab",
      "item": null,
      "sourceTab": null, "activeTab": null, "expected": "film-narrative" },
    { "name": "empty categories array is ignored",
      "item": { "categories": [] },
      "sourceTab": "fantasy", "activeTab": "crime", "expected": "film-fantasy" }
  ]
}
